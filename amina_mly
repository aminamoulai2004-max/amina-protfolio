/* Cards */
.box {
  width: 100%;
  max-width: 600px;
  margin: 24px auto 0;
  padding: 24px 20px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: var(--card);
  box-shadow: 0 6px 22px var(--shadow);
}
.box p:last-child { margin-bottom: 0; }

.chips {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 8px; margin-top: 8px;
}
.chip {
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--lilac-soft);
  color: var(--rose-deep);
  font: bold 14px "Courier New", monospace;
}

.item + .item {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px dashed var(--line);
}

.contact-row {
  display: block;
  padding: 14px 8px;
  color: var(--muted);
  text-decoration: none;
  font-size: 17px;
  border-radius: 12px;
  overflow-wrap: anywhere;
  transition: background .2s;
}
.contact-row + .contact-row { border-top: 1px dashed var(--line); }
.contact-row:hover, .contact-row:focus-visible { background: var(--lilac-soft); outline: none; }
.contact-row .highlight { display: block; margin-bottom: 4px; }

footer {
  padding: 28px 18px 40px;
  font: 14px "Courier New", monospace;
  color: var(--muted);
}
footer b { color: var(--rose-deep); }

@media (min-width: 700px) {
  section { padding: 80px 20px; }
  nav a { padding: 10px 18px; font-size: 16px; }
  .box { padding: 30px; }
  p { font-size: 18px; }
}
